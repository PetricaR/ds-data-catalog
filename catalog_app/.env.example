# Copy to .env for local development:  cp .env.example .env
# In production these come from the Kubernetes ConfigMap and Secret created by deploy/deploy.sh.

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://catalog:catalog@localhost:5432/ds_catalog

# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Encrypts the secrets stored in the database (users' Google tokens, an OAuth client entered at /setup).
# Same format; keep it — losing it means users sign in again and the client is re-entered.
# Comma-separate several to rotate: the first encrypts, all decrypt. Empty = derived from JWT_SECRET.
ENCRYPTION_KEY=

# Google OAuth2 client (APIs & Services → Credentials → OAuth client ID → Web application).
# Authorised redirect URI: http://localhost:5173/api/v1/auth/callback
# Or leave both empty and enter the client in the setup wizard (/setup) with the setup token
# the backend prints at startup (LOG_SETUP_TOKEN=false: only `python -m backend.setup_token`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# Who may sign in (comma-separated, case-insensitive). With all three empty, nobody can sign in.
# Leave the last three empty to set them on the Settings page instead; a value set here wins.
ADMIN_EMAILS=you@example.com
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=
# Role for new users: viewer | editor (empty: viewer)
DEFAULT_ROLE=

# Local development only: sign in without Google, as any email and role (or run `./start.sh --local`).
# The backend refuses to start with it unless FRONTEND_URL is a localhost URL.
LOCAL_MODE=false

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Default project for BigQuery sync. Uses Application Default Credentials locally
# (gcloud auth application-default login) and Workload Identity on GKE.
GCP_PROJECT_ID=your-gcp-project-id
# Optional: Secret Manager secret holding a service account key JSON for BigQuery jobs
BQ_SECRET_NAME=

# ── Optional integrations ─────────────────────────────────────────────────────
# Both can be entered on the Settings page instead; a value set here wins.
# Gemini API key — leave empty to use Vertex AI
GEMINI_API_KEY=
# Google Chat space webhook for metadata-change alerts
GOOGLE_CHAT_WEBHOOK_URL=

CORS_ORIGINS=["http://localhost:5173"]
